---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	project: CollectionEntry<"projects">;
	style?: string;
}

const { project, style } = Astro.props;
const className = Astro.props.class;
const { title, description, tech, url, github, status } = project.data;
---
<div class:list={["card-base flex flex-col rounded-[var(--radius-large)] p-7 md:p-8 transition", className]} style={style}>
    <div class="flex items-start justify-between gap-3">
        <h3 class="transition font-bold text-xl leading-snug text-90 hover:text-[var(--primary)]">{title}</h3>
        {status && (
            <span class="transition shrink-0 text-xs px-2.5 py-1 rounded-full bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                {status}
            </span>
        )}
    </div>

    {description && (
        <p class="transition text-75 mt-3 leading-relaxed">{description}</p>
    )}

    {tech.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
            {tech.map((t) => (
                <span class="transition text-xs px-2.5 py-1 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                    {t}
                </span>
            ))}
        </div>
    )}

    {(url || github) && (
        <div class="flex gap-3 mt-5 pt-5 border-t border-dashed border-black/10 dark:border-white/15">
            {url && (
                <a href={url} target="_blank" rel="noopener"
                   class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                    <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs"></Icon>
                    在线访问
                </a>
            )}
            {github && (
                <a href={github} target="_blank" rel="noopener"
                   class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                    <Icon name="fa6-brands:github" class="text-sm"></Icon>
                    GitHub
                </a>
            )}
        </div>
    )}
</div>
