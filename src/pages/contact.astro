---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { profileConfig } from "../config";

// 联系页文案（编辑 src/content/spec/contact.md）
const contactPost = await getEntry("spec", "contact");
const { title, subtitle } = contactPost.data;

// 联系方式（用户补充后修改这里）
const email = "2899893413@qq.com";
const channels = profileConfig.links;

// Web3Forms 访问密钥：
// 1. 打开 https://web3forms.com 用收件邮箱（大号 2899893413@qq.com）注册
// 2. 邮箱收到验证链接，点击激活，页面会显示你的 Access Key
// 3. 把下面的占位字符串替换成真实 Access Key（它等同邮箱别名，放前端是安全的）
const WEB3FORMS_ACCESS_KEY = "41755341-b071-4157-802a-c8900ef81f27";
---

<MainGridLayout title="联系">
    <!-- 标题 -->
    <section class="onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-12 md:py-14">
        <h1 class="transition font-extrabold text-4xl md:text-5xl leading-tight text-90">
            {title}
        </h1>
        <p class="transition text-lg md:text-xl mt-4 text-75 leading-relaxed max-w-[36rem]">
            {subtitle}
        </p>
    </section>

    <!-- 联系渠道 -->
    <section class="mt-16">
        <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
            <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
            联系渠道
        </h2>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
            {email && (
                <div class="card-base flex items-center gap-4 rounded-[var(--radius-large)] p-6 transition">
                    <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)]">
                        <Icon name="material-symbols:mail-rounded" class="text-2xl"></Icon>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="transition font-bold text-90">邮箱</div>
                        <div class="transition text-75 text-sm mt-1 break-all">{email}</div>
                    </div>
                    <div class="flex flex-col gap-2 shrink-0">
                        <a href={`mailto:${email}`}
                           class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                            <Icon name="material-symbols:edit-rounded" class="text-sm"></Icon>
                            写信
                        </a>
                        <button type="button" id="copy-email"
                                class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                            <Icon name="material-symbols:content-copy-rounded" class="text-sm"></Icon>
                            复制
                        </button>
                    </div>
                </div>
            )}
            {channels.map((c) => (
                <a href={c.url} target="_blank" rel="noopener"
                   class="card-base flex items-center gap-4 rounded-[var(--radius-large)] p-6 transition hover:scale-[1.02] active:scale-[0.98]">
                    <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)]">
                        <Icon name={c.icon} class="text-2xl"></Icon>
                    </div>
                    <div>
                        <div class="transition font-bold text-90">{c.name}</div>
                        <div class="transition text-75 text-sm mt-1">{c.url}</div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- 留言表单（Web3Forms 直发博主邮箱） -->
    <section class="mt-16 md:mt-20">
        <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
            <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
            给我留言
        </h2>
        <div class="mt-8 card-base rounded-[var(--radius-large)] p-6 md:p-8 transition">
            <form id="contact-form" class="flex flex-col gap-8">
                <!-- Web3Forms 配置：access_key + 蜜罐防垃圾 -->
                <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY}>
                <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-2">
                        <label for="cf-name" class="transition text-sm font-medium text-75">称呼</label>
                        <input id="cf-name" name="name" type="text" required placeholder="你的称呼"
                               class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] outline-none focus:ring-2 focus:ring-[var(--primary)] text-90"
                        >
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="cf-email" class="transition text-sm font-medium text-75">邮箱（选填，方便回复你）</label>
                        <input id="cf-email" name="email" type="email" placeholder="你的邮箱"
                               class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] outline-none focus:ring-2 focus:ring-[var(--primary)] text-90"
                        >
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <label for="cf-message" class="transition text-sm font-medium text-75">留言内容</label>
                    <textarea id="cf-message" name="message" rows="5" required placeholder="写下你的想法…"
                              class="transition px-4 py-3 rounded-lg bg-[var(--btn-regular-bg)] outline-none focus:ring-2 focus:ring-[var(--primary)] text-90 resize-y"
                    ></textarea>
                </div>

                <div class="flex flex-col gap-3">
                    <button type="submit" id="cf-submit"
                            class="transition flex items-center justify-center gap-2 h-12 px-8 rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold hover:brightness-110 active:scale-95">
                        <Icon name="material-symbols:send-rounded"></Icon>
                        发送留言
                    </button>
                    <p id="cf-status" class="transition text-sm text-75" role="status" aria-live="polite"></p>
                </div>
            </form>
        </div>
    </section>

    <!-- 表单交互：提交到 Web3Forms + 邮箱复制 -->
    <div id="contact-config" data-access-key={WEB3FORMS_ACCESS_KEY} data-email={email} hidden></div>
    <script is:inline>
        (function () {
            const cfg = document.getElementById("contact-config");
            const ACCESS_KEY = cfg ? cfg.dataset.accessKey : "";
            const EMAIL = cfg ? cfg.dataset.email : "";
            const form = document.getElementById("contact-form");
            const statusEl = document.getElementById("cf-status");
            const submitBtn = document.getElementById("cf-submit");

            function setStatus(text, ok) {
                statusEl.textContent = text;
                statusEl.classList.toggle("text-emerald-600", ok === true);
                statusEl.classList.toggle("dark:text-emerald-400", ok === true);
                statusEl.classList.toggle("text-red-500", ok === false);
                statusEl.classList.toggle("dark:text-red-400", ok === false);
            }

            // 提交留言 → Web3Forms
            if (form && ACCESS_KEY && ACCESS_KEY !== "YOUR_ACCESS_KEY") {
                form.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    submitBtn.disabled = true;
                    setStatus("正在发送…", undefined);
                    const data = Object.fromEntries(new FormData(form).entries());
                    try {
                        const res = await fetch("https://api.web3forms.com/submit", {
                            method: "POST",
                            headers: { "Content-Type": "application/json", "Accept": "application/json" },
                            body: JSON.stringify(Object.assign({}, data, {
                                subject: "博客联系留言",
                                from_name: data.name || "访客",
                            })),
                        });
                        const result = await res.json();
                        if (result.success) {
                            setStatus("已发送！感谢你的留言，我会尽快回复。", true);
                            form.reset();
                        } else {
                            setStatus("发送失败：" + (result.message || "未知错误，请稍后再试或直接写信。" ), false);
                        }
                    } catch (err) {
                        setStatus("网络异常，发送失败。可直接复制上方邮箱写信给我。", false);
                    } finally {
                        submitBtn.disabled = false;
                    }
                });
            } else if (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    setStatus("留言功能尚未配置（缺少 Web3Forms 访问密钥），请先用上方「写信 / 复制」联系。", false);
                });
            }

            // 复制邮箱
            const copyBtn = document.getElementById("copy-email");
            if (copyBtn) {
                copyBtn.addEventListener("click", async function () {
                    try {
                        await navigator.clipboard.writeText(EMAIL);
                        const old = copyBtn.innerHTML;
                        copyBtn.innerHTML = '已复制 ✓';
                        setTimeout(function () { copyBtn.innerHTML = old; }, 1500);
                    } catch (err) {
                        // 剪贴板不可用时的兜底
                        copyBtn.innerHTML = '请手动复制';
                        setTimeout(function () { copyBtn.innerHTML = '复制'; }, 1500);
                    }
                });
            }
        })();
    </script>
</MainGridLayout>
