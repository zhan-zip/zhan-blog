---
import { getCollection } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("projects");
---

<MainGridLayout title="项目">
    <section class="onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-12 md:py-14">
        <h1 class="transition font-extrabold text-4xl md:text-5xl leading-tight text-90">
            项目
        </h1>
        <p class="transition text-lg md:text-xl mt-4 text-75 leading-relaxed max-w-[36rem]">
            我做过的一些项目与练习作品。
        </p>
        <p class="transition text-sm mt-2 text-50">
            点击查看项目详情。
        </p>
    </section>

    {projects.length > 0 ? (
        <section class="mt-20">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 project-grid group">
                {projects.map((project, i) => (
                    <ProjectCard
                        project={project}
                        class="project-card onload-animation group-hover:opacity-40 hover:!opacity-100"
                        style={`animation-delay: calc(var(--content-delay) + ${i * 80}ms);`}
                    ></ProjectCard>
                ))}
            </div>
        </section>
    ) : (
        <section class="mt-16">
            <p class="transition text-75">暂无项目，敬请期待。</p>
        </section>
    )}
</MainGridLayout>
