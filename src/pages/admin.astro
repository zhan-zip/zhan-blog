---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

// 后台配置
const OWNER = "zhan-zip";
const REPO = "zhan-blog";
const POSTS_PATH = "src/content/posts";
---

<MainGridLayout title="内容管理">
    <section class="onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-10 md:py-12">
        <h1 class="transition font-extrabold text-3xl md:text-4xl leading-tight text-90">
            内容管理后台
        </h1>
        <p class="transition text-75 mt-3 leading-relaxed max-w-[36rem]">
            在这里写文章，保存后会自动提交到 GitHub 并发布到博客。首次使用需要填入一次 GitHub 访问令牌。
        </p>
    </section>

    <!-- 授权区 -->
    <section class="mt-12">
        <div class="card-base rounded-[var(--radius-large)] p-6 md:p-8 transition">
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)]">
                    <Icon name="fa6-brands:github" class="text-xl"></Icon>
                </div>
                <h2 class="transition font-bold text-xl text-90">GitHub 连接</h2>
                <span id="auth-state" class="ml-auto text-sm font-medium text-75">检查中…</span>
            </div>

            <!-- 未授权：输入令牌 -->
            <div id="auth-flow" class="mt-6 hidden">
                <p class="transition text-75 text-sm">请输入你的 GitHub 个人访问令牌（PAT）：</p>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                    <input id="token-input" type="password" placeholder="ghp_…"
                           autocomplete="off" spellcheck="false"
                           class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] outline-none focus:ring-2 focus:ring-[var(--primary)] text-90 font-mono text-sm min-w-[16rem] flex-1 max-w-[24rem]">
                    <button id="save-token"
                            class="transition flex items-center gap-2 h-11 px-6 rounded-lg bg-[var(--primary)] text-white dark:text-black/80 font-bold hover:brightness-110 active:scale-95">
                        <Icon name="material-symbols:link-rounded"></Icon>
                        保存并连接
                    </button>
                </div>
                <p class="transition text-xs text-75 mt-3">
                    🔒 令牌只保存在<b>当前浏览器</b>，不会上传服务器、不会写入代码仓库。如何创建令牌：
                    GitHub → Settings → Developer settings → Personal access tokens (classic) → 勾选 <code>repo</code> scope → Generate。
                </p>
            </div>

            <!-- 已授权 -->
            <div id="auth-ok" class="mt-6 hidden">
                <p class="transition text-sm text-75">已连接 <span id="auth-user" class="font-bold text-90"></span> ✓</p>
                <button id="logout-btn" class="transition mt-3 text-sm font-medium text-red-500 hover:underline">断开连接（清除令牌）</button>
            </div>
        </div>
    </section>

    <!-- 数据统计（Umami 共享仪表盘） -->
    <section class="mt-12">
        <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
            <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
            数据统计
        </h2>
        <div class="mt-6 card-base rounded-[var(--radius-large)] p-2 md:p-3 transition">
            <iframe src="https://cloud.umami.is/share/CTzVRIgXe4jtM1i8"
                    title="网站访问统计"
                    class="w-full border-0 rounded-xl"
                    style="height: 700px;"
                    loading="lazy"></iframe>
        </div>
    </section>

    <!-- 文章管理 -->
    <section id="post-manager" class="mt-12 hidden">
        <div class="flex items-center justify-between">
            <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
                <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
                已有文章
            </h2>
            <button id="refresh-list" class="transition text-sm font-medium text-[var(--primary)] hover:underline">刷新</button>
        </div>
        <ul id="post-list" class="mt-6 card-base rounded-[var(--radius-large)] p-4 md:p-6 flex flex-col gap-2 transition"></ul>

        <div class="flex items-center justify-between mt-14">
            <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
                <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
                新建文章
            </h2>
        </div>
        <div class="mt-6 card-base rounded-[var(--radius-large)] p-8 transition flex flex-col items-center text-center">
            <p class="transition text-75">写文章请在独立编辑页操作（支持 Markdown 实时预览）。</p>
            <a href={url("admin/new-post/")}
               class="transition flex items-center justify-center gap-2 mt-6 h-12 px-8 rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold hover:brightness-110 active:scale-95">
                <Icon name="material-symbols:edit-rounded"></Icon>
                去写文章
            </a>
        </div>
    </section>

    <!-- 后台逻辑：PAT + GitHub Contents API -->
    <script is:inline>
        (function () {
            const CFG = {
                owner: "zhan-zip",
                repo: "zhan-blog",
                postsPath: "src/content/posts",
                api: "https://api.github.com",
            };
            const TOKEN_KEY = "zhanblog_admin_token";
            const USER_KEY = "zhanblog_admin_user";

            const $ = (id) => document.getElementById(id);
            const stateEl = $("auth-state");
            const flowEl = $("auth-flow");
            const okEl = $("auth-ok");
            const managerEl = $("post-manager");

            function setState(text) { stateEl.textContent = text; }
            function setStatus(el, text, ok) {
                el.textContent = text;
                el.classList.toggle("text-emerald-600", ok === true);
                el.classList.toggle("dark:text-emerald-400", ok === true);
                el.classList.toggle("text-red-500", ok === false);
                el.classList.toggle("dark:text-red-400", ok === false);
                if (ok === true) el.classList.remove("text-75");
            }

            function utf8ToBase64(str) {
                const bytes = new TextEncoder().encode(str);
                let bin = "";
                bytes.forEach((b) => (bin += String.fromCharCode(b)));
                return btoa(bin);
            }

            function onAuthed(token) {
                flowEl.classList.add("hidden");
                okEl.classList.remove("hidden");
                managerEl.classList.remove("hidden");
                setState("已连接");
                fetch(CFG.api + "/user", { headers: { Authorization: "Bearer " + token } })
                    .then((r) => r.json())
                    .then((u) => { if (u.login) { $("auth-user").textContent = u.login; localStorage.setItem(USER_KEY, u.login); } })
                    .catch(() => {});
                loadPosts();
            }

            function logout() {
                localStorage.removeItem(TOKEN_KEY);
                localStorage.removeItem(USER_KEY);
                location.reload();
            }

            // ---------- 文章管理 ----------
            async function loadPosts() {
                const token = localStorage.getItem(TOKEN_KEY);
                const listEl = $("post-list");
                listEl.textContent = "加载中…";
                try {
                    const res = await fetch(CFG.api + "/repos/" + CFG.owner + "/" + CFG.repo + "/contents/" + CFG.postsPath, {
                        headers: { Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
                    });
                    const data = await res.json();
                    if (!Array.isArray(data)) throw new Error(data.message || "无法获取文章列表");
                    const items = data.filter((f) => f.name.endsWith(".md") && f.type === "file");
                    if (items.length === 0) { listEl.textContent = "还没有文章。"; return; }
                    listEl.innerHTML = "";
                    items.sort((a, b) => (a.name < b.name ? 1 : -1));
                    items.forEach((f) => {
                        const li = document.createElement("li");
                        li.className = "flex items-center justify-between gap-4 px-4 py-2.5 rounded-lg bg-[var(--btn-regular-bg)]";
                        const name = document.createElement("span");
                        name.className = "transition text-sm text-90 truncate";
                        name.textContent = f.name;
                        const link = document.createElement("a");
                        link.className = "transition shrink-0 text-sm font-medium text-[var(--primary)] hover:underline";
                        link.textContent = "查看";
                        link.href = "/zhan-blog/posts/" + f.name.replace(".md", "") + "/";
                        link.target = "_blank";
                        li.append(name, link);
                        listEl.appendChild(li);
                    });
                } catch (e) {
                    listEl.textContent = "加载失败：" + e.message;
                }
            }

            // 保存令牌
            $("save-token").addEventListener("click", async function () {
                const token = $("token-input").value.trim();
                if (!token) { setState("请输入令牌"); return; }
                setState("连接中…");
                try {
                    const res = await fetch(CFG.api + "/user", { headers: { Authorization: "Bearer " + token } });
                    const data = await res.json();
                    if (data.login) {
                        localStorage.setItem(TOKEN_KEY, token);
                        onAuthed(token);
                    } else {
                        setState("令牌无效：" + (data.message || "请检查令牌"));
                    }
                } catch (e) {
                    setState("连接失败：" + e.message);
                }
            });
            $("token-input").addEventListener("keydown", function (e) {
                if (e.key === "Enter") $("save-token").click();
            });

            $("refresh-list").addEventListener("click", loadPosts);
            $("logout-btn").addEventListener("click", logout);

            // ---------- 初始化 ----------
            (function init() {
                const token = localStorage.getItem(TOKEN_KEY);
                if (token) {
                    onAuthed(token);
                } else {
                    setState("未连接");
                    flowEl.classList.remove("hidden");
                }
            })();
        })();
    </script>
</MainGridLayout>
