---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { url } from "../../utils/url-utils";

const TOKEN_KEY = "zhanblog_admin_token";
---

<Layout title="写文章">
    <main class="w-full px-4 md:px-8 py-6">
        <!-- 顶栏 -->
        <div class="flex items-center justify-between mb-6">
            <a href={url("admin/")}
               class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                <Icon name="material-symbols:arrow-back-rounded"></Icon>
                返回后台
            </a>
            <h1 class="transition font-bold text-2xl md:text-3xl text-90">写文章</h1>
            <div class="w-24"></div>
        </div>

        <div class="flex gap-6 items-start">
            <!-- 左侧竖向固定：Markdown 快速对照 -->
            <aside class="hidden lg:block w-40 shrink-0 sticky top-24 self-start max-h-[calc(100vh-9rem)] overflow-y-auto">
                <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-5 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm">
                    <h3 class="font-bold text-sm text-90 mb-1">Markdown 快速对照</h3>
                    <p class="text-[0.7rem] text-50 mb-4">点击语法，插入到正文光标处</p>

                    <div class="flex flex-col gap-4">
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">标题</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="# 大号标题" class="insert-btn"># 大号</button>
                                <button type="button" data-insert="## 中号标题" class="insert-btn">## 中号</button>
                                <button type="button" data-insert="### 小号标题" class="insert-btn">### 小号</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">文字样式</p>
                            <div class="flex flex-wrap gap-1.5">
                                <button type="button" data-insert="**加粗文字**" class="insert-btn">加粗</button>
                                <button type="button" data-insert="*斜体文字*" class="insert-btn">斜体</button>
                                <button type="button" data-insert="`行内代码`" class="insert-btn">代码</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">列表 / 引用</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="- 无序列表项" class="insert-btn">- 无序列表</button>
                                <button type="button" data-insert="1. 有序列表项" class="insert-btn">1. 有序列表</button>
                                <button type="button" data-insert="> 引用文字" class="insert-btn">&gt; 引用</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">链接 / 分隔</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="[文字说明](https://)" class="insert-btn">链接</button>
                                <button type="button" data-insert="\n---\n" class="insert-btn">--- 分隔线</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">代码块</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="```\n代码写在这里\n```" class="insert-btn">``` 代码块</button>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- 主内容 -->
            <div class="flex-1 min-w-0">
                <!-- 顶部：要填的部分 -->
                <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-6 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm mb-6">
                    <form id="new-post-form" class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                            <label for="np-title" class="transition text-sm font-medium text-75">标题 *</label>
                            <input id="np-title" type="text" required placeholder="文章标题"
                                   class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div class="flex flex-col gap-2">
                                <label for="np-slug" class="transition text-sm font-medium text-75">文件名 *</label>
                                <input id="np-slug" type="text" required placeholder="如 my-post"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-date" class="transition text-sm font-medium text-75">日期</label>
                                <input id="np-date" type="date"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-category" class="transition text-sm font-medium text-75">分类</label>
                                <input id="np-category" type="text" placeholder="如 教程"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-tags" class="transition text-sm font-medium text-75">标签（逗号分隔）</label>
                                <input id="np-tags" type="text" placeholder="如 前端, Vue"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label for="np-desc" class="transition text-sm font-medium text-75">摘要</label>
                            <input id="np-desc" type="text" placeholder="一句话摘要（可选）"
                                   class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                        </div>
                    </form>
                </div>

                <!-- 下面：编辑（textarea，原生可靠选择）+ 预览，左右等高 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="relative rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-5 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm flex flex-col">
                        <label for="np-content" class="transition text-sm font-medium text-75 mb-3">正文（Markdown）*</label>
                        <!-- 选中文字后弹出的浮动格式工具栏（跟随鼠标） -->
                        <div id="fmt-toolbar" class="hidden absolute z-10 flex items-center gap-1 p-1.5 rounded-lg bg-[var(--btn-regular-bg)] border border-black/10 dark:border-white/15 shadow-md">
                            <button type="button" data-fmt="bold" title="加粗" class="fmt-btn"><Icon name="material-symbols:format-bold-rounded"></Icon></button>
                            <button type="button" data-fmt="italic" title="斜体" class="fmt-btn"><Icon name="material-symbols:format-italic-rounded"></Icon></button>
                            <button type="button" data-fmt="strike" title="删除线" class="fmt-btn"><Icon name="material-symbols:format-strikethrough-rounded"></Icon></button>
                            <button type="button" data-fmt="code" title="行内代码" class="fmt-btn"><Icon name="material-symbols:code-rounded"></Icon></button>
                            <button type="button" data-fmt="quote" title="引用" class="fmt-btn"><Icon name="material-symbols:format-quote-rounded"></Icon></button>
                            <button type="button" data-fmt="link" title="链接" class="fmt-btn"><Icon name="material-symbols:link-rounded"></Icon></button>
                        </div>
                        <textarea id="np-content" rows="20" required placeholder="在这里用 Markdown 写正文，右侧实时预览…"
                                  class="transition flex-1 w-full h-[calc(100vh-23rem)] min-h-[520px] px-4 py-3 rounded-lg bg-transparent border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90 resize-none font-mono text-sm leading-relaxed"></textarea>
                    </div>
                    <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-5 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm flex flex-col">
                        <div class="flex items-center gap-2 mb-3">
                            <Icon name="material-symbols:visibility-rounded" class="text-[var(--primary)]"></Icon>
                            <h2 class="transition font-bold text-sm text-90">预览</h2>
                            <span id="word-count" class="ml-auto text-xs text-75"></span>
                        </div>
                        <div id="preview"
                             class="transition flex-1 h-[calc(100vh-23rem)] min-h-[520px] overflow-y-auto prose dark:prose-invert max-w-none text-[0.9rem] leading-relaxed text-75"></div>
                    </div>
                </div>

                <!-- 发布 -->
                <div class="mt-6 flex flex-col gap-3">
                    <button id="np-submit"
                            class="transition flex items-center justify-center gap-2 h-14 px-12 text-base rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold border-2 border-black/30 dark:border-white/30 hover:brightness-110 hover:shadow-lg active:scale-95">
                        <Icon name="material-symbols:upload-rounded" class="text-xl"></Icon>
                        发布文章
                    </button>
                    <p id="np-status" class="transition text-sm text-75" role="status" aria-live="polite"></p>
                </div>
            </div>
        </div>
    </main>

    <style is:global>
        /* 补全局变量（写文章页用简单布局，缺侧边栏页面的变量注入） */
        :root {
            --primary: oklch(0.55 0.21 var(--hue));
            --page-bg: oklch(1 0 0);
            --card-bg: white;
            --btn-content: oklch(0.55 0.12 var(--hue));
            --btn-regular-bg: oklch(0.95 0.025 var(--hue));
            --btn-regular-bg-hover: oklch(0.9 0.05 var(--hue));
            --btn-regular-bg-active: oklch(0.85 0.08 var(--hue));
            --btn-card-bg-hover: oklch(0.98 0.005 var(--hue));
            --btn-card-bg-active: oklch(0.9 0.03 var(--hue));
            --line-color: rgba(0, 0, 0, 0.1);
            --line-divider: rgba(0, 0, 0, 0.08);
            --radius-large: 1rem;
        }
        :root.dark {
            --primary: oklch(0.70 0.17 var(--hue));
            --page-bg: oklch(0.15 0.012 var(--hue));
            --card-bg: oklch(0.20 0.014 var(--hue));
            --btn-content: oklch(0.75 0.1 var(--hue));
            --btn-regular-bg: oklch(0.33 0.035 var(--hue));
            --btn-regular-bg-hover: oklch(0.38 0.04 var(--hue));
            --btn-regular-bg-active: oklch(0.43 0.045 var(--hue));
            --btn-card-bg-hover: oklch(0.3 0.03 var(--hue));
            --btn-card-bg-active: oklch(0.35 0.035 var(--hue));
            --line-color: rgba(255, 255, 255, 0.1);
            --line-divider: rgba(255, 255, 255, 0.08);
        }
    </style>

    <style>
        .insert-btn {
            transition: all 0.15s ease;
            font-size: 0.75rem;
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            text-align: left;
            padding: 0.4rem 0.625rem;
            border-radius: 0.5rem;
            background: var(--btn-regular-bg);
            color: var(--btn-content);
            border: 1px solid var(--line-color);
            cursor: pointer;
        }
        .insert-btn:hover {
            color: var(--primary);
            background: var(--btn-regular-bg-hover);
            border-color: var(--primary);
        }
        .insert-btn:active {
            transform: scale(0.95);
        }
        .fmt-btn {
            transition: all 0.15s ease;
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.5rem;
            color: var(--btn-content);
            cursor: pointer;
            border: none;
            background: transparent;
        }
        .fmt-btn:hover {
            background: var(--btn-regular-bg-hover);
            color: var(--primary);
        }
        .fmt-btn:active {
            transform: scale(0.9);
        }
    </style>

    <script>
        import MarkdownIt from "markdown-it";

        // 写文章页不需要 swup 页面切换动画，禁用避免干扰
        if (window.swup) {
            try { window.swup.destroy?.(); } catch (e) { /* ignore */ }
        }

        const CFG = { owner: "zhan-zip", repo: "zhan-blog", postsPath: "src/content/posts", api: "https://api.github.com" };
        const TOKEN_KEY = "zhanblog_admin_token";
        const $ = (id) => document.getElementById(id);
        const form = $("new-post-form");
        const content = $("np-content");
        const preview = $("preview");
        const wordCount = $("word-count");
        const statusEl = $("np-status");
        const submitBtn = $("np-submit");

        // markdown-it 渲染引擎
        const mdEngine = new MarkdownIt({ html: false, linkify: true, breaks: true });

        // 默认日期
        $("np-date").value = new Date().toISOString().slice(0, 10);

        function setStatus(text, ok) {
            statusEl.textContent = text;
            statusEl.classList.toggle("text-emerald-600", ok === true);
            statusEl.classList.toggle("dark:text-emerald-400", ok === true);
            statusEl.classList.toggle("text-red-500", ok === false);
            statusEl.classList.toggle("dark:text-red-400", ok === false);
            if (ok === true) statusEl.classList.remove("text-75");
        }

        function utf8ToBase64(str) {
            const bytes = new TextEncoder().encode(str);
            let bin = "";
            bytes.forEach((b) => (bin += String.fromCharCode(b)));
            return btoa(bin);
        }

        // 实时预览
        function renderPreview() {
            const text = content.value;
            wordCount.textContent = text.trim().length + " 字";
            preview.innerHTML = mdEngine.render(text);
        }
        content.addEventListener("input", renderPreview);

        // 选中文字后显示格式工具栏，点击给选中文字包裹 Markdown 语法
        const toolbar = $("fmt-toolbar");
        const fmtMap = {
            bold: ["**", "**"],
            italic: ["*", "*"],
            strike: ["~~", "~~"],
            code: ["`", "`"],
        };

        let mousePos = { x: 0, y: 0 };
        function hideToolbar() { toolbar.classList.add("hidden"); }

        // 工具栏中心对齐鼠标，显示在鼠标正上方（上方放不下则显示在下方）
        function positionToolbar() {
            const card = toolbar.closest(".relative");
            const cardRect = card.getBoundingClientRect();
            const w = toolbar.offsetWidth, h = toolbar.offsetHeight;
            let left = mousePos.x - cardRect.left - w / 2;
            left = Math.max(4, Math.min(left, cardRect.width - w - 4));
            let top = mousePos.y - cardRect.top - h - 10;
            if (top < 4) top = mousePos.y - cardRect.top + 24; // 上方放不下，放鼠标下方
            top = Math.max(4, top);
            toolbar.style.left = left + "px";
            toolbar.style.top = top + "px";
        }
        function showToolbar() {
            positionToolbar();
            toolbar.classList.remove("hidden");
        }

        // 记录鼠标位置并重新定位工具栏（mouseup 晚于 selectionchange，需修正位置）
        content.addEventListener("mouseup", (e) => {
            mousePos = { x: e.clientX, y: e.clientY };
            if (!toolbar.classList.contains("hidden")) positionToolbar();
        });

        // 选区变化时显示/隐藏工具栏
        document.addEventListener("selectionchange", () => {
            if (content.selectionStart !== content.selectionEnd) {
                showToolbar();
            } else {
                hideToolbar();
            }
        });

        // 失焦时隐藏（点工具栏按钮不会失焦，按钮 mousedown preventDefault）
        content.addEventListener("blur", () => {
            setTimeout(() => { if (document.activeElement !== content) hideToolbar(); }, 150);
        });

        // 清理选中文本内部的 Markdown 标记（*、#、~、` 等），再重新格式化，避免嵌套错乱
        function stripMarkdown(input) {
            return input
                .replace(/\*\*(.+?)\*\*/g, "$1")
                .replace(/\*(.+?)\*/g, "$1")
                .replace(/~~(.+?)~~/g, "$1")
                .replace(/`(.+?)`/g, "$1")
                .replace(/^\s*#+\s*/gm, "")
                .replace(/^\s*>\s*/gm, "");
        }

        // toggle 格式：重复点同一格式 = 取消；加粗/斜体可叠加；先清理内部标记再包格式
        function applyFormat(fmt) {
            const start = content.selectionStart, end = content.selectionEnd;
            if (start === end) return;
            const text = content.value;
            const sel = stripMarkdown(text.slice(start, end));
            let newText, newStart, newEnd;

            if (fmt === "quote") {
                const quoted = sel.split("\n").map((l) => "> " + l).join("\n");
                newText = text.slice(0, start) + quoted + text.slice(end);
                newStart = start; newEnd = start + quoted.length;
            } else if (fmt === "link") {
                newText = text.slice(0, start) + "[" + sel + "](https://)" + text.slice(end);
                newStart = start + 1; newEnd = start + 1 + sel.length;
            } else if (fmt === "bold" || fmt === "italic") {
                // 统计选区前后紧邻的 * 数量，实现加粗/斜体叠加 + toggle
                let beforeStars = 0;
                for (let i = start - 1; i >= 0 && text[i] === "*"; i--) beforeStars++;
                let afterStars = 0;
                for (let i = end; i < text.length && text[i] === "*"; i++) afterStars++;
                if (fmt === "bold") {
                    if (beforeStars >= 2 && afterStars >= 2) {
                        newText = text.slice(0, start - 2) + sel + text.slice(end + 2);
                        newStart = start - 2; newEnd = end - 2;
                    } else {
                        newText = text.slice(0, start) + "**" + sel + "**" + text.slice(end);
                        newStart = start + 2; newEnd = end + 2;
                    }
                } else {
                    if (beforeStars % 2 === 1 && afterStars % 2 === 1) {
                        newText = text.slice(0, start - 1) + sel + text.slice(end + 1);
                        newStart = start - 1; newEnd = end - 1;
                    } else {
                        newText = text.slice(0, start) + "*" + sel + "*" + text.slice(end);
                        newStart = start + 1; newEnd = end + 1;
                    }
                }
            } else {
                const [before, after] = fmtMap[fmt];
                const len = before.length;
                const wrapped = text.slice(0, start).endsWith(before) && text.slice(end).startsWith(after);
                if (wrapped) {
                    newText = text.slice(0, start - len) + sel + text.slice(end + len);
                    newStart = start - len; newEnd = end - len;
                } else {
                    newText = text.slice(0, start) + before + sel + after + text.slice(end);
                    newStart = start + len; newEnd = end + len;
                }
            }
            content.value = newText;
            content.focus();
            content.selectionStart = newStart;
            content.selectionEnd = newEnd;
            renderPreview();
            hideToolbar();
        }

        document.querySelectorAll("#fmt-toolbar [data-fmt]").forEach((btn) => {
            // mousedown 阻止默认，避免点击按钮时 textarea 失焦丢选区
            btn.addEventListener("mousedown", (e) => e.preventDefault());
            btn.addEventListener("click", () => applyFormat(btn.dataset.fmt));
        });

        // 点击语法按钮 → 插入到正文光标处
        function insertAtCursor(text) {
            text = text.replace(/\\n/g, "\n");
            const start = content.selectionStart, end = content.selectionEnd;
            content.value = content.value.slice(0, start) + text + content.value.slice(end);
            content.focus();
            content.selectionStart = content.selectionEnd = start + text.length;
            renderPreview();
        }
        document.querySelectorAll("[data-insert]").forEach((btn) => {
            btn.addEventListener("click", () => insertAtCursor(btn.dataset.insert || ""));
        });

        // 发布
        form.addEventListener("submit", async function (e) {
            e.preventDefault();
            const token = localStorage.getItem(TOKEN_KEY);
            if (!token) { setStatus("未配置 GitHub 令牌，请先到后台「GitHub 连接」保存令牌。", false); return; }

            const title = $("np-title").value.trim();
            const slug = $("np-slug").value.trim();
            const published = $("np-date").value || new Date().toISOString().slice(0, 10);
            const category = $("np-category").value.trim();
            const tags = $("np-tags").value.split(/[,，]/).map((t) => t.trim()).filter(Boolean);
            const description = $("np-desc").value.trim();
            const body = content.value;

            if (!title || !slug || !body) { setStatus("请填写标题、文件名和正文。", false); return; }

            let fm = "---\n";
            fm += "title: " + title + "\n";
            fm += "published: " + published + "\n";
            if (description) fm += "description: " + description + "\n";
            if (category) fm += "category: " + category + "\n";
            if (tags.length) fm += "tags: [" + tags.join(", ") + "]\n";
            fm += "---\n\n";
            const mdFile = fm + body.trim() + "\n";

            submitBtn.disabled = true;
            setStatus("发布中…", undefined);
            try {
                const res = await fetch(CFG.api + "/repos/" + CFG.owner + "/" + CFG.repo + "/contents/" + CFG.postsPath + "/" + slug + ".md", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json", Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
                    body: JSON.stringify({ message: "后台发布文章：" + title, content: utf8ToBase64(mdFile), branch: "main" }),
                });
                const data = await res.json();
                if (data.content) {
                    setStatus("已发布！约 2 分钟后线上生效。可继续写下一篇。", true);
                    form.reset();
                    $("np-date").value = new Date().toISOString().slice(0, 10);
                    renderPreview();
                } else {
                    setStatus("发布失败：" + (data.message || "未知错误"), false);
                }
            } catch (err) {
                setStatus("发布出错：" + err.message, false);
            } finally {
                submitBtn.disabled = false;
            }
        });

        // 未连接时提示
        if (!localStorage.getItem(TOKEN_KEY)) {
            setStatus("提示：尚未配置 GitHub 令牌，发布前请先到后台「GitHub 连接」保存令牌。", false);
        }
    </script>
</Layout>
