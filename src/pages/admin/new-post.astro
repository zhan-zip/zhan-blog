---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { url } from "../../utils/url-utils";

const TOKEN_KEY = "zhanblog_admin_token";
---

<Layout title="写文章">
    <main class="w-full px-4 md:px-8 py-6">
        <!-- 顶栏 -->
        <div class="flex items-center justify-between mb-6">
            <a href={url("admin/")}
               class="transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                <Icon name="material-symbols:arrow-back-rounded"></Icon>
                返回后台
            </a>
            <h1 class="transition font-bold text-2xl md:text-3xl text-90">写文章</h1>
            <div class="w-24"></div>
        </div>

        <div class="flex gap-6 items-start">
            <!-- 左侧竖向固定：Markdown 快速对照 -->
            <aside class="hidden lg:block w-40 shrink-0 sticky top-24 self-start max-h-[calc(100vh-9rem)] overflow-y-auto">
                <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-5 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm">
                    <h3 class="font-bold text-sm text-90 mb-1">Markdown 快速对照</h3>
                    <p class="text-[0.7rem] text-50 mb-4">点击语法，插入到正文光标处</p>

                    <div class="flex flex-col gap-4">
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">标题</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="# 大号标题" class="insert-btn"># 大号</button>
                                <button type="button" data-insert="## 中号标题" class="insert-btn">## 中号</button>
                                <button type="button" data-insert="### 小号标题" class="insert-btn">### 小号</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">文字样式</p>
                            <div class="flex flex-wrap gap-1.5">
                                <button type="button" data-insert="**加粗文字**" class="insert-btn">加粗</button>
                                <button type="button" data-insert="*斜体文字*" class="insert-btn">斜体</button>
                                <button type="button" data-insert="`行内代码`" class="insert-btn">代码</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">列表 / 引用</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="- 无序列表项" class="insert-btn">- 无序列表</button>
                                <button type="button" data-insert="1. 有序列表项" class="insert-btn">1. 有序列表</button>
                                <button type="button" data-insert="> 引用文字" class="insert-btn">&gt; 引用</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">链接 / 分隔</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="[文字说明](https://)" class="insert-btn">链接</button>
                                <button type="button" data-insert="\n---\n" class="insert-btn">--- 分隔线</button>
                            </div>
                        </div>
                        <div>
                            <p class="text-[0.7rem] font-bold text-50 mb-2">代码块</p>
                            <div class="flex flex-col gap-1.5">
                                <button type="button" data-insert="```\n代码写在这里\n```" class="insert-btn">``` 代码块</button>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- 主内容 -->
            <div class="flex-1 min-w-0">
                <!-- 顶部：要填的部分 -->
                <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-6 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm mb-6">
                    <form id="new-post-form" class="flex flex-col gap-4" novalidate>
                        <div class="flex flex-col gap-2">
                            <label for="np-title" class="transition text-sm font-medium text-75">标题 *</label>
                            <input id="np-title" type="text" required placeholder="文章标题"
                                   class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div class="flex flex-col gap-2">
                                <label for="np-slug" class="transition text-sm font-medium text-75">文件名 *</label>
                                <input id="np-slug" type="text" required placeholder="如 my-post"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-date" class="transition text-sm font-medium text-75">日期</label>
                                <input id="np-date" type="date"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-category" class="transition text-sm font-medium text-75">分类</label>
                                <input id="np-category" type="text" placeholder="如 教程"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="np-tags" class="transition text-sm font-medium text-75">标签（逗号分隔）</label>
                                <input id="np-tags" type="text" placeholder="如 前端, Vue"
                                       class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label for="np-desc" class="transition text-sm font-medium text-75">摘要</label>
                            <input id="np-desc" type="text" placeholder="一句话摘要（可选）"
                                   class="transition h-11 px-4 rounded-lg bg-[var(--btn-regular-bg)] border border-black/25 dark:border-white/25 outline-none focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)] text-90">
                        </div>
                    </form>
                </div>

                <!-- Editor.md 富文本编辑器（自带工具栏 + 分屏实时预览） -->
                <div class="rounded-2xl border border-black/10 dark:border-white/15 bg-[oklch(0.985_0.003_250)] dark:bg-[var(--card-bg)] p-2 transition hover:border-black/25 dark:hover:border-white/25 hover:shadow-sm">
                    <div id="md-content" style="z-index: 1;">
                        <textarea id="np-content" style="display:none;"></textarea>
                    </div>
                </div>
                <!-- 本地图片上传（点工具栏图片按钮触发） -->
                <input type="file" id="image-input" accept="image/*" class="hidden">

                <!-- 发布 -->
                <div class="mt-6 flex flex-col gap-3">
                    <button id="np-submit" type="button"
                            class="transition flex items-center justify-center gap-2 h-14 px-12 text-base rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold border-2 border-black/30 dark:border-white/30 hover:brightness-110 hover:shadow-lg active:scale-95">
                        <Icon name="material-symbols:upload-rounded" class="text-xl"></Icon>
                        发布文章
                    </button>
                    <p id="np-status" class="transition text-sm text-75" role="status" aria-live="polite"></p>
                </div>
            </div>
        </div>
    </main>

    <!-- 全局顶部提示 toast -->
    <div id="toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-white font-medium shadow-lg"></div>

    <style is:global>
        /* 补全局变量（写文章页用简单布局，缺侧边栏页面的变量注入） */
        :root {
            --primary: oklch(0.55 0.21 var(--hue));
            --page-bg: oklch(1 0 0);
            --card-bg: white;
            --btn-content: oklch(0.55 0.12 var(--hue));
            --btn-regular-bg: oklch(0.95 0.025 var(--hue));
            --btn-regular-bg-hover: oklch(0.9 0.05 var(--hue));
            --btn-regular-bg-active: oklch(0.85 0.08 var(--hue));
            --btn-card-bg-hover: oklch(0.98 0.005 var(--hue));
            --btn-card-bg-active: oklch(0.9 0.03 var(--hue));
            --line-color: rgba(0, 0, 0, 0.1);
            --line-divider: rgba(0, 0, 0, 0.08);
            --radius-large: 1rem;
        }
        :root.dark {
            --primary: oklch(0.70 0.17 var(--hue));
            --page-bg: oklch(0.15 0.012 var(--hue));
            --card-bg: oklch(0.20 0.014 var(--hue));
            --btn-content: oklch(0.75 0.1 var(--hue));
            --btn-regular-bg: oklch(0.33 0.035 var(--hue));
            --btn-regular-bg-hover: oklch(0.38 0.04 var(--hue));
            --btn-regular-bg-active: oklch(0.43 0.045 var(--hue));
            --btn-card-bg-hover: oklch(0.3 0.03 var(--hue));
            --btn-card-bg-active: oklch(0.35 0.035 var(--hue));
            --line-color: rgba(255, 255, 255, 0.1);
            --line-divider: rgba(255, 255, 255, 0.08);
        }
    </style>

    <style>
        .insert-btn {
            transition: all 0.15s ease;
            font-size: 0.75rem;
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            text-align: left;
            padding: 0.4rem 0.625rem;
            border-radius: 0.5rem;
            background: var(--btn-regular-bg);
            color: var(--btn-content);
            border: 1px solid var(--line-color);
            cursor: pointer;
        }
        .insert-btn:hover {
            color: var(--primary);
            background: var(--btn-regular-bg-hover);
            border-color: var(--primary);
        }
        .insert-btn:active {
            transform: scale(0.95);
        }
    </style>

    <script>
        // 写文章页不需要 swup 页面切换动画，禁用避免干扰
        if (window.swup) {
            try { window.swup.destroy?.(); } catch (e) { /* ignore */ }
        }

        const CFG = { owner: "zhan-zip", repo: "zhan-blog", postsPath: "src/content/posts", api: "https://api.github.com" };
        const TOKEN_KEY = "zhanblog_admin_token";
        const BASE = import.meta.env.BASE_URL;
        const $ = (id) => document.getElementById(id);
        const form = $("new-post-form");
        const statusEl = $("np-status");
        const submitBtn = $("np-submit");
        let contentEditor = null;
        const isDark = () => document.documentElement.classList.contains("dark");

        function setStatus(text, ok) {
            statusEl.textContent = text;
            statusEl.classList.toggle("text-emerald-600", ok === true);
            statusEl.classList.toggle("dark:text-emerald-400", ok === true);
            statusEl.classList.toggle("text-red-500", ok === false);
            statusEl.classList.toggle("dark:text-red-400", ok === false);
            if (ok === true) statusEl.classList.remove("text-75");
        }

        // 屏幕顶部全局提示（表单验证 / 发布状态）
        let toastTimer;
        function showToast(msg, ok) {
            const t = $("toast");
            t.textContent = msg;
            t.classList.remove("hidden");
            t.style.background = ok ? "oklch(0.55 0.21 var(--hue))" : "#dc2626";
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.classList.add("hidden"), 3000);
        }

        function utf8ToBase64(str) {
            const bytes = new TextEncoder().encode(str);
            let bin = "";
            bytes.forEach((b) => (bin += String.fromCharCode(b)));
            return btoa(bin);
        }

        // 动态加载脚本 / 样式
        function loadAsset(src, isCss) {
            return new Promise((resolve, reject) => {
                if (isCss) {
                    const l = document.createElement("link");
                    l.rel = "stylesheet"; l.href = src;
                    l.onload = resolve; l.onerror = reject;
                    document.head.appendChild(l);
                } else {
                    const s = document.createElement("script");
                    s.src = src; s.onload = resolve; s.onerror = reject;
                    document.head.appendChild(s);
                }
            });
        }

        // 加载 jQuery + Editor.md 并初始化
        async function initEditor() {
            try {
                await loadAsset("https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js");
                await loadAsset(BASE + "lib/editormd/css/editormd.min.css", true);
                await loadAsset(BASE + "lib/editormd/editormd.min.js");
                if (!window.editormd) { setStatus("编辑器加载失败，请刷新重试。", false); return; }
                contentEditor = window.editormd("md-content", {
                    width: "100%",
                    height: "620px",
                    syncScrolling: "single",
                    path: BASE + "lib/editormd/lib/",
                    markdown: "",
                    watch: true,
                    toolbarIcons: "full",
                    theme: isDark() ? "pastel-on-dark" : "default",
                    previewTheme: isDark() ? "dark" : "default",
                    editorTheme: isDark() ? "pastel-on-dark" : "default",
                    onload: function () {
                        // 覆盖工具栏图片按钮：改为本地选图（避开默认的 URL 填表弹窗）
                        jQuery('.editormd-toolbar a').each(function () {
                            const t = (this.title || '');
                            if (t.indexOf('图片') !== -1 || t.indexOf('image') !== -1) {
                                jQuery(this).off('click').on('click', function (e) {
                                    e.preventDefault();
                                    document.getElementById('image-input').click();
                                });
                            }
                        });
                    },
                });
                bindImageUpload();
            } catch (e) {
                setStatus("编辑器加载出错：" + e.message, false);
            }
        }

        // 语法对照栏点击 → 插入到编辑器光标处
        function insertAtCursor(text) {
            text = text.replace(/\\n/g, "\n");
            if (contentEditor) {
                contentEditor.insertValue(text);
            }
        }
        document.querySelectorAll("[data-insert]").forEach((btn) => {
            btn.addEventListener("click", () => insertAtCursor(btn.dataset.insert || ""));
        });

        // 默认日期
        $("np-date").value = new Date().toISOString().slice(0, 10);

        // 发布
        form.addEventListener("submit", async function (e) {
            e.preventDefault();
            const token = localStorage.getItem(TOKEN_KEY);
            if (!token) { setStatus("未配置 GitHub 令牌，请先到后台「GitHub 连接」保存令牌。", false); return; }
            if (!contentEditor) { setStatus("编辑器尚未加载完成，请稍等。", false); return; }

            const title = $("np-title").value.trim();
            const slug = $("np-slug").value.trim();
            const published = $("np-date").value || new Date().toISOString().slice(0, 10);
            const category = $("np-category").value.trim();
            const tags = $("np-tags").value.split(/[,，]/).map((t) => t.trim()).filter(Boolean);
            const description = $("np-desc").value.trim();
            const body = contentEditor.getMarkdown();

            if (!title || !slug || !body) {
                const missing = !title ? "标题" : (!slug ? "文件名" : "正文");
                setStatus("请填写" + missing + "。", false);
                showToast("请填写" + missing, false);
                return;
            }

            let fm = "---\n";
            fm += "title: " + title + "\n";
            fm += "published: " + published + "\n";
            if (description) fm += "description: " + description + "\n";
            if (category) fm += "category: " + category + "\n";
            if (tags.length) fm += "tags: [" + tags.join(", ") + "]\n";
            fm += "---\n\n";
            const mdFile = fm + body.trim() + "\n";

            submitBtn.disabled = true;
            setStatus("发布中…", undefined);
            try {
                const path = CFG.postsPath + "/" + slug + ".md";
                // 文件已存在则获取 sha（GitHub 更新已有文件必须带 sha）
                let existingSha = null;
                try {
                    const check = await fetch(CFG.api + "/repos/" + CFG.owner + "/" + CFG.repo + "/contents/" + path, {
                        headers: { Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
                    });
                    if (check.ok) {
                        const d = await check.json();
                        existingSha = d.sha;
                    }
                } catch (e) { /* 文件不存在则跳过 */ }

                const putBody = { message: "后台发布文章：" + title, content: utf8ToBase64(mdFile), branch: "main" };
                if (existingSha) putBody.sha = existingSha;

                const res = await fetch(CFG.api + "/repos/" + CFG.owner + "/" + CFG.repo + "/contents/" + path, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json", Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
                    body: JSON.stringify(putBody),
                });
                const data = await res.json();
                if (data.content) {
                    setStatus("已提交，正在部署（约 2 分钟后线上生效）。", true);
                    showToast("已提交，正在部署", true);
                    form.reset();
                    $("np-date").value = new Date().toISOString().slice(0, 10);
                    contentEditor.setMarkdown("");
                } else {
                    const errMsg = data.message || "未知错误";
                    setStatus("发布失败：" + errMsg, false);
                    showToast("发布失败：" + errMsg, false);
                }
            } catch (err) {
                setStatus("发布出错：" + err.message, false);
            } finally {
                submitBtn.disabled = false;
            }
        });

        // 未连接时提示
        if (!localStorage.getItem(TOKEN_KEY)) {
            setStatus("提示：尚未配置 GitHub 令牌，发布前请先到后台「GitHub 连接」保存令牌。", false);
        }

        // 本地图片上传：选图 → 上传到 GitHub public/images/ → 插入图片链接
        function bindImageUpload() {
            const input = $("image-input");
            input.addEventListener("change", async function () {
                const file = input.files[0];
                input.value = ""; // 允许重复选同一文件
                if (!file) return;
                const token = localStorage.getItem(TOKEN_KEY);
                if (!token) { setStatus("未配置 GitHub 令牌，无法上传图片。", false); return; }

                const reader = new FileReader();
                reader.onload = async function (e) {
                    const base64 = e.target.result.split(",")[1];
                    const name = file.name.replace(/\.[^.]+$/, "");
                    const ext = (file.name.split(".").pop() || "png").toLowerCase();
                    const filename = Date.now() + "-" + name.replace(/[^a-zA-Z0-9-_]/g, "").slice(0, 30) + "." + ext;
                    const path = "public/images/" + filename;
                    const url = BASE + "images/" + filename;
                    setStatus("正在上传图片…", undefined);
                    try {
                        const res = await fetch(CFG.api + "/repos/" + CFG.owner + "/" + CFG.repo + "/contents/" + path, {
                            method: "PUT",
                            headers: { "Content-Type": "application/json", Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
                            body: JSON.stringify({ message: "上传图片：" + filename, content: base64, branch: "main" }),
                        });
                        const data = await res.json();
                        if (data.content) {
                            contentEditor.insertValue("![" + name + "](" + url + ")");
                            setStatus("图片已上传并插入正文（约 2 分钟后线上可见）。", true);
                        } else {
                            setStatus("图片上传失败：" + (data.message || "未知错误"), false);
                        }
                    } catch (err) {
                        setStatus("图片上传出错：" + err.message, false);
                    }
                };
                reader.readAsDataURL(file);
            });
        }

        // 发布按钮在表单外，点击时手动触发表单提交
        $("np-submit").addEventListener("click", () => form.requestSubmit());

        initEditor();
    </script>
</Layout>
