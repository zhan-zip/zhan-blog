---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

// 最新文章：非草稿，取前 4 篇
const posts = (await getSortedPosts()).slice(0, 4);
// 精选项目：取 featured 前 3 个
const projects = (await getCollection("projects"))
	.filter((p) => p.data.featured)
	.slice(0, 3);
// 首页 Hero 文案（编辑 src/content/spec/home.md）
const homePost = await getEntry("spec", "home");
const { heroTitle, heroSubtitle, ctaContact, ctaProjects } = homePost.data;
---

<MainGridLayout title="首页">
    <!-- Hero -->
    <section class="onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-14 md:py-20">
        <h1 class="transition font-extrabold text-4xl md:text-5xl leading-tight text-90">
            {heroTitle}
        </h1>
        <p class="transition text-lg md:text-xl mt-6 text-75 leading-relaxed max-w-[36rem]">
            {heroSubtitle}
        </p>
        <div class="flex flex-wrap gap-5 mt-12">
            <a href={url("contact/")}
               class="transition flex items-center justify-center gap-2 h-12 px-6 rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold hover:brightness-110 active:scale-95">
                <Icon name="material-symbols:mail-rounded"></Icon>
                {ctaContact}
            </a>
            <a href={url("projects/")}
               class="transition btn-card flex items-center gap-2 h-12 px-6 rounded-xl border-2 border-[var(--primary)] text-[var(--primary)] font-bold active:scale-95">
                <Icon name="material-symbols:rocket-launch-rounded"></Icon>
                {ctaProjects}
            </a>
        </div>
    </section>

    <!-- 精选项目 -->
    {projects.length > 0 && (
        <section class="mt-20 md:mt-24">
            <div class="flex items-center justify-between">
                <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
                    <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
                    精选项目
                </h2>
                <a href={url("projects/")}
                   class="onload-animation transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                    查看全部
                    <Icon name="material-symbols:arrow-forward-rounded"></Icon>
                </a>
            </div>
            <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8">
                {projects.map((project, i) => (
                    <ProjectCard
                        project={project}
                        class="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${i * 80}ms);`}
                    ></ProjectCard>
                ))}
            </div>
        </section>
    )}

    <!-- 最新文章 -->
    <section class="mt-20 md:mt-24">
        <div class="flex items-center justify-between">
            <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
                <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
                最新文章
            </h2>
            <a href={url("archive/")}
               class="onload-animation transition flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:underline">
                查看全部
                <Icon name="material-symbols:arrow-forward-rounded"></Icon>
            </a>
        </div>
        <div class="transition flex flex-col gap-8 mt-10">
            {posts.map((entry, i) => (
                <PostCard
                    entry={entry}
                    title={entry.data.title}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.slug)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    class:list="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${i * 80}ms);`}
                ></PostCard>
            ))}
        </div>
    </section>
</MainGridLayout>
