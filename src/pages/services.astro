---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

// 服务方向（占位内容，用户可按需编辑）
const services = [
	{
		name: "Web 开发",
		desc: "网页 / 网站 / 单页应用，可加 PWA 离线能力。",
		icon: "material-symbols:code-rounded",
		items: ["响应式页面", "前端交互", "静态站点 / 应用"],
	},
	{
		name: "全栈 + Agent 辅助开发",
		desc: "前后端一体，借助 Agent 工具高效落地需求。",
		icon: "material-symbols:robot-2-rounded",
		items: ["前后端联调", "接口设计", "AI 辅助提效"],
	},
	{
		name: "学生课程设计",
		desc: "帮助学生完成课程设计 / 毕业设计相关开发。",
		icon: "material-symbols:school-rounded",
		items: ["课程项目", "代码讲解", "文档配套"],
	},
];

const workflow = [
	{ step: "咨询", desc: "聊聊你的需求与想法" },
	{ step: "报价", desc: "确认范围与时间" },
	{ step: "开发", desc: "分阶段交付并沟通" },
	{ step: "交付", desc: "验收与后续支持" },
];
---

<MainGridLayout title="服务">
    <!-- 定位 -->
    <section class="onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-12 md:py-14">
        <h1 class="transition font-extrabold text-4xl md:text-5xl leading-tight text-90">
            服务
        </h1>
        <p class="transition text-lg md:text-xl mt-4 text-75 leading-relaxed max-w-[38rem]">
            我可以提供以下方向的开发支持。当前接单合作暂未开放，欢迎先联系交流。
        </p>
    </section>

    <!-- 服务方向卡片 -->
    <section class="mt-16">
        <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
            <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
            服务方向
        </h2>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            {services.map((s, i) => (
                <div class:list={["card-base flex flex-col rounded-[var(--radius-large)] p-6 md:p-7 transition onload-animation"]}
                     style={`animation-delay: calc(var(--content-delay) + ${i * 80}ms);`}>
                    <div class="transition flex items-center justify-center w-12 h-12 rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)]">
                        <Icon name={s.icon} class="text-2xl"></Icon>
                    </div>
                    <h3 class="transition font-bold text-xl mt-5 text-90">{s.name}</h3>
                    <p class="transition text-75 mt-2 leading-relaxed">{s.desc}</p>
                    <ul class="mt-4 flex flex-col gap-2">
                        {s.items.map((item) => (
                            <li class="transition flex items-center gap-2 text-sm text-75">
                                <Icon name="material-symbols:check-rounded" class="text-[var(--primary)]"></Icon>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <!-- 合作流程 -->
    <section class="mt-16 md:mt-20">
        <h2 class="onload-animation transition flex items-center gap-3 font-bold text-2xl md:text-3xl text-90">
            <span class="w-1.5 h-6 rounded-md bg-[var(--primary)]"></span>
            合作流程
        </h2>
        <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-6">
            {workflow.map((w, i) => (
                <div class:list={["card-base rounded-[var(--radius-large)] p-6 transition onload-animation"]}
                     style={`animation-delay: calc(var(--content-delay) + ${i * 80}ms);`}>
                    <div class="transition flex items-center gap-3">
                        <span class="transition flex items-center justify-center w-9 h-9 rounded-full bg-[var(--primary)] text-white dark:text-black/80 font-bold text-sm">
                            {i + 1}
                        </span>
                        <h3 class="transition font-bold text-lg text-90">{w.step}</h3>
                    </div>
                    <p class="transition text-75 text-sm mt-3 leading-relaxed">{w.desc}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- 联系 CTA -->
    <section class="mt-16 md:mt-20 onload-animation transition bg-[var(--card-bg)] rounded-[var(--radius-large)] px-6 md:px-10 py-12 flex flex-col items-center text-center">
        <h2 class="transition font-bold text-2xl md:text-3xl text-90">有想法想聊聊？</h2>
        <p class="transition text-75 mt-3">欢迎通过联系页给我留言，我会尽快回复。</p>
        <a href={url("contact/")}
           class="transition btn-card flex items-center gap-2 mt-8 h-12 px-6 rounded-xl bg-[var(--primary)] text-white dark:text-black/80 font-bold hover:brightness-110 active:scale-95">
            <Icon name="material-symbols:mail-rounded"></Icon>
            联系我
        </a>
    </section>
</MainGridLayout>
